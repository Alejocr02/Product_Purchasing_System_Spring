# Plantilla segura de configuracion para Spring Boot + .env
#
# Copiar este archivo a .env y reemplazar solo los valores reales del ambiente.
# No subir .env al control de versiones.

DB_HOST=YOUR_DB_HOST
DB_PORT=3306
DB_NAME=YOUR_DB_NAME
DB_USER=YOUR_DB_USER
DB_PASSWORD=YOUR_SECURE_PASSWORD

DB_DDL_AUTO=none
DB_SHOW_SQL=false
DB_POOL_SIZE=10

APP_ENVIRONMENT=production
SPRING_PROFILES_ACTIVE=production

LOG_LEVEL=INFO
LOG_SQL_LEVEL=WARN
LOG_SQL_BIND_LEVEL=OFF
